# TruthLayer Backend Environment
# Copy this file to backend/.env and adjust as needed.

# Prisma connection string. Local development uses a SQLite file.
DATABASE_URL="file:./dev.db"

# Port the backend listens on (defaults to 3002 if unset).
PORT=3002

# --- ai-service ---
# Base URL of the local Ollama instance (defaults to http://localhost:11434 if unset).
# OLLAMA_BASE_URL="http://localhost:11434"
